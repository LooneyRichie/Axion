func join(array, delimiter) {
    // Join array elements with delimiter
    if (length(array) == 0) then {
        return "";
    }
    
    set result = array[0];
    loop(i from 1 to length(array) - 1 step 1) {
        result = result + delimiter + array[i];
    }
    return result;
}